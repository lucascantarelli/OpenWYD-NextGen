# Imagem do site de documentação.
#
# Parte da imagem oficial do Material for MkDocs e trata o repositório como
# /docs (o compose monta o bind). `serve` recarrega ao editar; `build --strict`
# é o gate do CI, e é o mesmo comando do cabeçalho do mkdocs.yml.
FROM squidfunk/mkdocs-material:latest

WORKDIR /docs