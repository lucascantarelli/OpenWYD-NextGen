# ---------------------------------------------------------------------------
# OpenWYD — variáveis de ambiente da stack
#
#   cp .env.example .env      # .env é gitignored; este exemplo é versionado
#
# `docker compose` carrega `./.env` sozinho e o shell vence o arquivo, então
#   W2PP_RATES_EDITING=true docker compose up -d openwyd-nextgen1-tmsrv
# funciona mesmo com `false` escrito abaixo.
#
# Nenhuma chave é obrigatória: cada uma tem default no compose ou no binário
# (as flags `-x` usam `os.Getenv("W2PP_X")` como default, e o argumento de CLI
# sempre vence a variável).
#
# Regra do projeto: aqui só entra **configuração de processo/deploy** (senha,
# segredo, caminho, liga/desliga). Número de gameplay (rate, drop, preço, EXP,
# curva) NÃO vem de env — vive em `Release/`, no banco e nos overlays do portal.
# ---------------------------------------------------------------------------

# --- Efetivos no `docker compose` -------------------------------------------

# Senha do superusuário do Postgres local. Só o `db-roles` (one-shot) e scripts
# de operação (backup/restore) usam este papel; nenhum serviço de aplicação.
POSTGRES_PASSWORD=dev

# DB-01: papéis separados. O mesmo valor precisa existir aqui e no `.env` para o
# serviço `db-roles` criar as roles e para os serviços conectarem.
#   migrator: dono dos objetos, roda migrations e seedgen
#   app:      DML (dbserver/webserver)
#   ro:       SELECT (relatório; nenhum serviço usa hoje)
OPENWYD_MIGRATOR_PASSWORD=dev-migrator
OPENWYD_APP_PASSWORD=dev-app
OPENWYD_RO_PASSWORD=dev-ro

# Segredo do cookie de sessão do portal (>= 32 caracteres). Troque em qualquer
# ambiente que não seja o dev local; depois recrie o container `portal`.
#   openssl rand -base64 48
W2PP_PORTAL_SESSION_SECRET=dev-only-portal-session-secret-32-chars

# Códigos de login de uso único emitidos pela web (IssuePlayCode). Vazio = off.
# O MESMO valor vai para o webServer e para o portal; >= 32 caracteres.
W2PP_PLAY_CODE_SECRET=

# Overlays de edição do portal, lidos pelo tmserver NO BOOT (o de teleporte é
# relido a cada 15 s). Cada um sobrepõe a configuração do banco ao conteúdo de
# `Release/`; todos exigem `-dbserver` e o seed correspondente.
#   dbserver import-npcs -content /content -dsn "$W2PP_DB_DSN"
# O catálogo de NPCs não é overlay: `npc_definition` é a única fonte de spawn.
W2PP_MOB_STAT_EDITING=false
W2PP_ITEM_EFFECT_EDITING=false
W2PP_RATES_EDITING=false
W2PP_DROP_CONFIG_EDITING=false
W2PP_TELEPORT_EDITING=false

# --- Só quando o binário roda no host (make run, provas, import-*) ----------

# Árvore de conteúdo. No compose ela é montada em /content e passada por flag.
# W2PP_CONTENT=/caminho/para/OpenWYD/tmserver/content

# Endereços gRPC internos (no compose são nomes de serviço, passados por flag).
# W2PP_DBSERVER=127.0.0.1:7514
# W2PP_BINSERVER=127.0.0.1:3000

# DSN para as ferramentas de importação (import-npcs, importteleports,
# import-world-events) e para os testes de integração do store.
# W2PP_DB_DSN=postgres://postgres:dev@127.0.0.1:5432/postgres

# HTTP de status que o cliente sonda (serv00.htm). O compose fixa :80 por flag.
# W2PP_STATUS_ADDR=:80

# --- Portal quando roda no host (`make portal-dev`) -------------------------
# O container recebe WEB_API_ADDR/LOG_PIPE_URL/AUDIT_LOG_DIR direto do compose;
# estes valores existem para `cd portal && npm run dev`. Detalhes e as variáveis
# de mTLS estão em `portal/.env.example`.
# SESSION_SECRET=<openssl rand -base64 48>
# WEB_API_ADDR=127.0.0.1:7600
# WEB_API_PROTO=../OpenWYD/api/web/v1/web.proto
# WEB_API_TLS_CA=../OpenWYD/certs/ca.crt
# WEB_API_TLS_CERT=../OpenWYD/certs/client.crt
# WEB_API_TLS_KEY=../OpenWYD/certs/client.key
# AUDIT_LOG_DIR=./logs
# LOG_PIPE_URL=

# --- mTLS interno (opcional; overlay `docker-compose.mtls.yaml`) ------------
# Gere com `make certs` (destino ./certs, gitignored). Caminhos são os de dentro
# do container; no host use os de ./certs.
# W2PP_TLS_CERT=/certs/tmserver.crt
# W2PP_TLS_KEY=/certs/tmserver.key
# W2PP_TLS_CA=/certs/ca.crt
# W2PP_TLS_SERVER_NAME=dbserver

# --- Ícones de item (opcional) ---------------------------------------------
# Sem o pack a UI cai no fallback (sigla do item) — não é erro.
# W2PP_ITEM_ICONS_MANIFEST=/published-item-icons-manifest.json
# W2PP_STORAGE_MANAGER_URL=
# W2PP_STORAGE_MANAGER_TOKEN=

# --- Testes e2e headless (não precisa do cliente Windows) ------------------
# W2PP_E2E_ADDR=127.0.0.1:8281
# W2PP_E2E_ACCOUNT=test
# W2PP_E2E_PASSWORD=test123
# W2PP_E2E_VERSION=12000
