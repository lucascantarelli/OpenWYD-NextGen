# ===========================================================================
# WYD - variaveis de ambiente (MODELO versionado; segredos NUNCA aqui)
# ===========================================================================
# USO
#   1. Copie:  `cp .env.example .env`  (`.env` esta no .gitignore)
#   2. Preencha os segredos abaixo (geracao: `openssl rand -base64 48`).
#   3. O compose carrega `.env` sozinho (`env_file` + interpolacao `${VAR}`).
#   4. O portal em dev (`npm run dev` em `wyd-portal/`) le `wyd-portal/.env.local`
#      - este arquivo alimenta os SERVICOS (compose); o portal le os mesmos
#      valores via `environment:` no compose. Nao duplique segredo a mao:
#      defina aqui e referencie la.
#
# REGRAS
#   - `.env` real jamais e commitado (ver `.gitignore`: `.env`, `.env.*`,
#     exceto este exemplo). Vazou segredo? Revogue e gere outro.
#   - Rust (crates/) NAO le ambiente em runtime (so `CARGO_MANIFEST_DIR` em
#     teste, resolvido em compilacao) - servico Rust configura por CLI/arquivo.
#   - Valores `troque-aqui` sao APENAS desenvolvimento local.
#   - Stack 100% Rust (arquivo Go removido em 2026-11; sem referência legada).
#     Serviços futuros entram com a issue dona (ver docs/rust/05-stack-docker.md).
# ===========================================================================

# --- Projeto / imagens (compose) -------------------------------------------
# Nome do projeto (prefixo default dos containers) e tag das imagens locais.
COMPOSE_PROJECT_NAME=wyd
TAG=dev

# --- PostgreSQL (servico `db`: imagem oficial postgres:17-alpine) ----------
POSTGRES_USER=wyd
POSTGRES_PASSWORD=troque-aqui-dev

# --- Observabilidade (FASE-12-1) -----------------------------------------
# Prometheus/Grafana/node-exporter sobem junto no `docker compose up`; a aba
# /monitoramento do portal le o Prometheus pela rede interna.
# Portas ficam em loopback (127.0.0.1) por padrao.
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
NODE_EXPORTER_PORT=9100
GRAFANA_USER=admin
GRAFANA_PASSWORD=troque-aqui-dev
POSTGRES_DB=wyd
# Porta publicada no host SOMENTE via override de dev (prod nao publica).
PGPORT=5432

# --- Staff de desenvolvimento (servico `staff-seed`) ----------------------
# Login padrao do portal: cria/atualiza a conta com papel `admin` (hash argon2id).
# Roda a cada `up` e e idempotente. TROQUE antes de expor a stack: a senha fica
# em `.env` (nunca versionado) e o portal aplica o bloqueio de forca minima.
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=troque-aqui-dev
WYD_SEED_STAFF=1

# --- Portal Next.js (servico `portal`) -------------------------------------
# Sessao httpOnly: >= 32 caracteres. Gere com `openssl rand -base64 48`.
SESSION_SECRET=troque-aqui-com-32-caracteres-no-minimo-0123456789
# Onde o BFF encontra o `wyd-admin` (HTTP/1.1 + JSON, ADR-0008). URL completa,
# loopback na v1. Sem backend no ar, a UI sobe e /api/health responde 502.
# Detalhes em `docs/rust/05-stack-docker.md` e `docs/arquitetura/c4-pacotes.md`.
WEB_API_ADDR=http://127.0.0.1:7600
# Token processo→processo portal → gateway (header `authorization: Bearer`, ADR-0022).
# OBRIGATÓRIO nos dois lados: o gateway não sobe sem ele (fail-closed) e o portal
# não autentica sem ele. Nunca versionado: defina no `.env` local (`openssl rand -hex 24`).
WEB_API_TOKEN=

# --- Gateway HTTP/JSON (servico `gateway`, ADR-0022) ------------------------
# `DATABASE_URL` e montada pelo compose a partir de POSTGRES_* (host `db`), por isso
# não aparece aqui. A porta só é publicada no override de dev, em loopback.
# Auditoria em arquivo (ndjson); o compose monta volume neste caminho.
AUDIT_LOG_DIR=/var/log/wyd-portal
# Porta publicada no host (override de dev).
PORTAL_PORT=3000

# --- Launcher (exe do cliente; FORA do compose) -----------------------------
# Sem variaveis: `update`/`check` recebem tudo por argumento. A imagem
# `docker/Dockerfile.launcher` e artefato de release/smoke (FASE-05-2):
#   docker build -f docker/Dockerfile.launcher -t wyd/launcher:dev .
#   docker run --rm wyd/launcher:dev update /jogo /pacote --key-file /chave.key
