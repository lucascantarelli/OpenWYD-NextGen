## Ignora arquivos temporários do Visual Studio, resultados de build e
## arquivos gerados por complementos populares do Visual Studio.

# Arquivos específicos do usuário
*.suo
*.user
*.userosscache
*.sln.docstates

# Arquivos específicos do usuário (MonoDevelop/Xamarin Studio)
*.userprefs

# Resultados de build
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Xx]64/
[Xx]86/
[Bb]uild/
bld/
[Bb]in/
!api/bin/
!api/bin/**
[Oo]bj/

# Diretório de cache/opções do Visual Studio 2015
.vs/
# Descomente se você tiver tarefas que criam os arquivos estáticos do projeto em wwwroot
#wwwroot/

# Resultados de teste do MSTest
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# Resultados de build de um projeto ATL
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

