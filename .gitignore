# Arquivos ignorados

# Material mTLS de dev (gerado por `make certs` / scripts/gen-certs.sh)
/certs/

# Cliente do jogo (binários proprietários, ~344 MB): nunca versionar.
/client/

# Portal Next.js (dependências e saída de build).
/portal/.next/
/portal/out/
/portal/next-env.d.ts

# Metadados locais do Freebuff (project-id do workspace).
/.freebuff/

# --- Variáveis de ambiente ---------------------------------------------------
# `.env` guarda segredo local (senha do banco, SESSION_SECRET) e o docker compose
# carrega o arquivo sozinho; só o exemplo é versionado.
.env
.env.*
!.env.example

# Saídas de build (mkdocs e logs de teste local)
/site/
/tmp/

# Rust (esqueleto workspace; sem tocar nas regras Go acima)
/target/
**/*.rs.bk

# Arquivo do legado Go (start-rust.md): conteúdo preservado via git,
# novos arquivos soltos aqui não entram no versionamento
.deprecated-go/

# Arquivos obsoletos
/.deprecated-go/