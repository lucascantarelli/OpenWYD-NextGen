# Arquivos ignorados

# Material mTLS de dev (gerado por `make certs` / scripts/gen-certs.sh)
/certs/

# Cliente do jogo (binários proprietários, ~344 MB): nunca versionar.
/client/

# Portal Next.js (dependências e saída de build).
/wyd-portal/.next/
/wyd-portal/out/
/wyd-portal/next-env.d.ts
/wyd-portal/node_modules/

# Metadados locais do Freebuff (project-id do workspace).
/.freebuff/

# --- Variáveis de ambiente ---------------------------------------------------
# `.env` guarda segredo local (senha do banco, SESSION_SECRET) e o docker compose
# carrega o arquivo sozinho; só o exemplo é versionado.
.env
.env.*
!.env.example

# Saídas de build (mkdocs e logs de teste local)
/site/
/tmp/

# Playwright (FASE-07-4): relatórios/traces nunca versionados
/wyd-portal/test-results/
/wyd-portal/playwright-report/
/wyd-portal/blob-report/

# Rust (workspace; sem Go no repo desde 2026-11)
/target/
**/*.rs.bk

# Tauri (FASE-08-8): schemas de ACL gerados pelo tauri-build a cada build.
/apps/launcher-ui/gen/
# Distribuição de artefatos (launcher/cliente): gerada, nunca versionada.
/dist/
