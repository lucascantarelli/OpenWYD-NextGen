{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WYD",
  "version": "0.1.0",
  "identifier": "br.com.dolorestec.wyd.launcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WYD",
        "width": 720,
        "height": 660,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
