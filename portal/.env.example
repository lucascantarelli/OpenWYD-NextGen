# web-api (OpenWYD/webserver) — gRPC puro, sem HTTP
WEB_API_ADDR=127.0.0.1:7600

# Segredo do cookie de sessão httpOnly (>= 32 chars). Gere com:
#   openssl rand -base64 48
SESSION_SECRET=

# Caminho alternativo do contrato (default: ../OpenWYD/api/web/v1/web.proto)
# WEB_API_PROTO=../OpenWYD/api/web/v1/web.proto

# mTLS (somente quando o web-api roda com W2PP_TLS_CERT/KEY/CA).
# Em dev a stack local sobe sem TLS e estes campos ficam vazios.
# WEB_API_TLS_CA=../OpenWYD/certs/ca.crt
# WEB_API_TLS_CERT=../OpenWYD/certs/client.crt
# WEB_API_TLS_KEY=../OpenWYD/certs/client.key

# Trilha de auditoria das ações admin. Sem isto, só o log do processo (stdout)
# recebe as linhas `[audit] {…}`; com isto, também <dir>/audit-YYYY-MM-DD.ndjson.
# AUDIT_LOG_DIR=./logs

# Ícones de item: `icon_url` só vem preenchida quando o web-api carrega o pack
# publicado (`webserver/cmd/itemiconpack` + `W2PP_ITEM_ICONS_MANIFEST` no serviço
# `webserver` do compose). Sem pack a UI usa o fallback (sigla do item) — não é
# erro: o catálogo continua completo. Exemplo do manifesto:
# W2PP_ITEM_ICONS_MANIFEST=../OpenWYD/dist/item-icons/manifest.json
