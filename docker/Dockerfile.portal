# syntax=docker/dockerfile:1
# Portal de administração (Next.js, BFF sobre o backend HTTP/JSON do wyd-admin,
# ADR-0008). O contexto é a raiz do repo (compose: context: . / dockerfile:
# docker/Dockerfile.portal); a imagem só precisa de wyd-portal/.
FROM node:22-alpine AS deps
WORKDIR /app
COPY wyd-portal/package.json wyd-portal/package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY wyd-portal/ ./
# Sem .proto no build (ADR-0008): o contrato é HTTP/JSON e o endereço do
# backend vem do ambiente em runtime.
RUN npm run build

# Runtime: apenas o standalone + estáticos.
FROM node:22-alpine AS run
LABEL org.opencontainers.image.title="wyd-portal" \
      org.opencontainers.image.description="Portal de administracao (Next.js, BFF sobre o web-api)" \
      org.opencontainers.image.source="https://github.com/lucascantarelli/wyd"
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
COPY --chown=node:node --from=build /app/.next/standalone ./
COPY --chown=node:node --from=build /app/.next/static ./.next/static
ENV WEB_API_ADDR=http://wyd-admin:7600
# Auditoria em arquivo (AUDIT_LOG_DIR); o compose monta um volume aqui.
RUN mkdir -p /var/log/wyd-portal && chown node:node /var/log/wyd-portal
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
