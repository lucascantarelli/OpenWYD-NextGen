{
  "uid": "wyd-logs",
  "title": "WYD · Logs dos containers",
  "tags": ["wyd", "logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"docker\"}, service)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "trace",
        "label": "trace_id",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Volume de log por serviço (linhas/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate({job=\"docker\", service=~\"$service\"} [1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Erros e avisos por serviço",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({job=\"docker\", service=~\"$service\"} |~ \"(?i)(level=error|panic|fatal)\" [5m]))",
          "legendFormat": "erro · {{service}}"
        },
        {
          "refId": "B",
          "expr": "sum by (service) (count_over_time({job=\"docker\", service=~\"$service\"} |~ \"(?i)(level=warn|warn(ing)?)\" [5m]))",
          "legendFormat": "aviso · {{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Linhas (erros primeiro)",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLines": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\", service=~\"$service\"} |~ \"(?i)(level=error|panic|fatal|level=warn)\"",
          "legendFormat": ""
        }
      ]
    }
  ]
}
