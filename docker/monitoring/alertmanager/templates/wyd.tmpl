{{/* Templates de notificação do WYD (DEVOPS-02).

    Objetivo: quem recebe o aviso no Slack entende em 3 segundos O QUE caiu (severidade),
    ONDE (canal/alvo), DESDE QUANDO, O QUE FAZER (runbook) e COMO CALAR (silence).

    Regras de desenho:
      - título = linha de assunto no app do Slack; por isso severidade vem antes do resto;
      - um bloco por alerta do grupo, com `run_url` do CI quando existir;
      - rodapé único por grupo com link do Alertmanager e atalho de silêncio;
      - `fingerprint` nunca aparece: é ruído para humano;
      - o link de silêncio usa `.ExternalURL`, que depende de `--web.external-url`
        (definido em `render-config.sh`), não do hostname do container.

    Render de prova (sem esperar alerta real):
      amtool template render --template.glob='/etc/alertmanager/templates/*.tmpl' \
        --template.text='{{ template "wyd.texto" . }}' \
        --template.data=/etc/alertmanager/slack-exemplo.json
*/}}

{{ define "wyd.severidade" }}{{ if eq .CommonLabels.severity "critical" }}:rotating_light: CRÍTICO{{ else if eq .CommonLabels.severity "warning" }}:warning: AVISO{{ else if eq .CommonLabels.severity "info" }}:information_source: INFO{{ else }}:grey_question: sem severidade{{ end }}{{ end }}

{{ define "wyd.icone" }}{{ if eq . "critical" }}:rotating_light:{{ else if eq . "warning" }}:warning:{{ else if eq . "info" }}:information_source:{{ else }}:grey_question:{{ end }}{{ end }}

{{ define "wyd.titulo" }}[{{ .Status | toUpper }}] {{ template "wyd.severidade" . }} · WYD {{ .CommonLabels.alertname }}{{ if .CommonLabels.canal }} · canal {{ .CommonLabels.canal }}{{ end }}{{ end }}

{{ define "wyd.texto" }}{{ range .Alerts }}{{ template "wyd.icone" .Labels.severity }} *{{ .Labels.severity }}* · {{ .Annotations.summary }}{{ if .Labels.canal }}
canal: `{{ .Labels.canal }}`{{ end }}{{ if .Labels.instance }} · alvo: `{{ .Labels.instance }}`{{ end }}{{ if .Labels.job }} · job: `{{ .Labels.job }}`{{ end }}{{ if .Labels.environment }}
ambiente: `{{ .Labels.environment }}`{{ end }}{{ if .Annotations.run_url }}
run: <{{ .Annotations.run_url }}|abrir o run do CI>{{ end }}{{ if .Annotations.runbook }}
runbook: {{ if match "^https?://" .Annotations.runbook }}<{{ .Annotations.runbook }}|abrir>{{ else }}`{{ .Annotations.runbook }}`{{ end }}{{ end }}
{{ if .EndsAt.IsZero }}desde {{ .StartsAt.Format "02/01 15:04 MST" }}{{ else }}encerrado {{ .EndsAt.Format "02/01 15:04 MST" }}{{ end }}

{{ end }}{{ if gt (len .Alerts) 1 }}_grupo com {{ len .Alerts }} alertas_ · {{ end }}<{{ .ExternalURL }}/#/alerts|Alertmanager>{{ if .CommonLabels.alertname }} · <{{ .ExternalURL }}/#/silences/new?filter=%7Balertname%3D%22{{ .CommonLabels.alertname }}%22%7D|silenciar>{{ end }}{{ end }}
